# ---------------- Local PostgreSQL ----------------
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=creative_os_db
DB_USER=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD
DB_SSL=false
DB_POOL_MAX=10

# Alternative: DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@127.0.0.1:5432/creative_os_db

# ---------------- Local asset/render storage ----------------
LOCAL_STORAGE_DIR=./storage

# ---------------- AI provider ----------------
# gemini | openai
AI_PROVIDER=gemini

# Gemini (recommended for this build)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLE_SEARCH=true
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional OpenAI fallback
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_QUALITY=high

# Optional independent image provider: gemini | openai
# If omitted, IMAGE_PROVIDER follows AI_PROVIDER.
IMAGE_PROVIDER=gemini

# ---------------- Workspace defaults ----------------
DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
DEMO_BRAND_ID=PF
DEMO_PRODUCT_ID=PF-COOKIE-BRK
